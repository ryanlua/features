{
    "rojo_at_pinned_version": {
        "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
        "features": {
            "rojo": {
                "version": "7.7.1"
            }
        }
    },
    "install_aftman": {
        "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
        "remoteUser": "vscode",
        "features": {
            "rojo": {
                "toolchainManager": "aftman"
            }
        }
    },
    "install_foreman": {
        "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
        "remoteUser": "vscode",
        "features": {
            "rojo": {
                "toolchainManager": "foreman"
            }
        }
    },
    "install_rokit": {
        "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
        "remoteUser": "vscode",
        "features": {
            "rojo": {
                "toolchainManager": "rokit"
            }
        }
    },
    "install_from_github": {
        "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
        "remoteUser": "vscode",
        "features": {
            "rojo": {
                "toolchainManager": "none"
            }
        }
    }
}
